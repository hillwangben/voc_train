# 轻量 CPU-only 基础镜像
FROM ubuntu:22.04

# 切换 apt 国内源
RUN sed -i 's|http://archive.ubuntu.com|http://mirrors.aliyun.com|g; s|http://security.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    ffmpeg \
    libsndfile1 \
    git \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python 依赖全部从交付包内的 wheelhouse 安装，构建时不访问 PyPI。
COPY wheels/ /opt/wheels/
COPY requirements-cpu-frozen.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir --no-index \
    --find-links=/opt/wheels \
    -r /tmp/requirements.txt && \
    rm -rf /opt/wheels

# 验证
RUN python3 -c "import torch, vosk, speechbrain, transformers, sentence_transformers, pycorrector; print('offline backends OK, torch:', torch.__version__)"

WORKDIR /workspace/algorithm

HEALTHCHECK NONE
LABEL maintainer="voc_train" version="v1" description="Speech CPU training env"
